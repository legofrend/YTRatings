# Monthly pipeline CLI (ingest group): python -m app.main auto | videos | …
FROM python:3.12 AS requirements-stage

WORKDIR /tmp

RUN pip install --no-cache-dir "poetry>=1.8,<3" poetry-plugin-export

COPY ./pyproject.toml ./poetry.lock* /tmp/

RUN poetry export -f requirements.txt --output requirements.txt --without-hashes --with ingest

FROM python:3.12

WORKDIR /code

COPY --from=requirements-stage /tmp/requirements.txt /code/requirements.txt

RUN pip install --no-cache-dir --upgrade -r /code/requirements.txt

COPY ./app /code/app
COPY ./scenarios /code/scenarios

RUN mkdir -p /code/logs

ENTRYPOINT ["python", "-m", "app.main"]
